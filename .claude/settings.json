{
  "permissions": {
    "deny": [
      "mcp__Google_Drive",
      "mcp__Gmail",
      "mcp__Google_Calendar"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hooks/nestor-hook claude session_start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hooks/nestor-hook claude before_mcp"
          }
        ]
      }
    ]
  }
}
