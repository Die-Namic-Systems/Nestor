#!/usr/bin/env bash
# Nestor hooks — same behavior for Cursor, Claude Code, and any CLI that
# invokes:  hooks/nestor-hook <cursor|claude> <session_start|before_mcp>
set -euo pipefail

FMT="${1:?usage: nestor-hook <cursor|claude> <session_start|before_mcp>}"
MODULE="${2:?usage: nestor-hook <cursor|claude> <session_start|before_mcp>}"

# Resolve the repo root from THIS SCRIPT's own location, not from cwd or a
# runtime-supplied variable. nestor-hook lives at <root>/hooks/nestor-hook, so
# its own path fixes the root even when the session is rooted above the repo (a
# multi-repo web checkout) or CLAUDE_PROJECT_DIR is unset — the failure that let
# a whole boot no-op (IDEAS §6.108). NESTOR_PROJECT_ROOT still wins as an
# explicit override, because tests relocate the tree with it; nothing else is
# more trustworthy than knowing where this file is.
SELF="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SELF_ROOT="$(cd -- "$(dirname -- "$SELF")/.." && pwd -P)"
ROOT="${NESTOR_PROJECT_ROOT:-$SELF_ROOT}"
cd "$ROOT"

export NESTOR_PROJECT_ROOT="$ROOT"

PY="python3"
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
fi

exec "$PY" -m hooks.hook_runner "$FMT" "$MODULE"
